{
  "name": "theLeadRouter \u2014 Ad Studio",
  "description": "Deploy your application, sign in, and connect Gemini and fal.ai in the setup wizard. Create, save, and download your first image ad. Railway and AI services bill your own accounts.",
  "publicationStatus": "unlisted_preview_automated_install_verified",
  "templateUrl": "https://railway.com/deploy/rNhJ3h?version=ad-studio",
  "sourceRepository": "jasonakatiff/theleadrouter-ad-studio",
  "sourceRevision": "fcf30f14e343d5811fa84c8c684c96ce05f9b23f",
  "sourceGate": "Release from reviewed public main after CI and pull-request merge; private Git history is excluded.",
  "installFields": [
    {
      "service": "Backend",
      "variable": "ADMIN_EMAIL",
      "label": "Owner email",
      "description": "Use this email to sign in to your new application.",
      "required": true,
      "preserveExisting": true
    },
    {
      "service": "Backend",
      "variable": "ADMIN_PASSWORD",
      "label": "Owner password",
      "description": "Choose 12 or more characters, at most 72 UTF-8 bytes. Save it in your password manager.",
      "required": true,
      "preserveExisting": true
    }
  ],
  "generatedVariables": [
    {
      "service": "Postgres",
      "variable": "POSTGRES_PASSWORD",
      "value": "${{secret(48)}}",
      "preserveExisting": true
    },
    {
      "service": "Backend",
      "variable": "SECRET_KEY",
      "value": "${{secret(64)}}",
      "preserveExisting": true
    },
    {
      "service": "Backend",
      "variable": "OAUTH_TOKEN_ENCRYPTION_KEY",
      "value": "${{secret(43, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_\")}}=",
      "preserveExisting": true
    }
  ],
  "publicServices": [
    "Frontend",
    "Backend"
  ],
  "privateServices": [
    "Postgres",
    "Worker"
  ],
  "volumes": {
    "Postgres": "/var/lib/postgresql/data",
    "Backend": "/app/uploads"
  },
  "support": "https://github.com/jasonakatiff/theleadrouter-ad-studio/issues",
  "customerGuide": "docs/deployment/install-on-railway.md",
  "generatedPublicDomains": {
    "Frontend": 8080,
    "Backend": 8080
  },
  "templateId": "fddb5b7e-1e34-421e-85c4-832c90182a50",
  "sourceBranch": "main",
  "remainingValidation": [
    "Funded live AI generation",
    "Independent Railway account dashboard walkthrough",
    "Nontechnical pilot timing",
    "Cloud backup and restore rehearsal"
  ]
}
