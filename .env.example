# Database (PostgreSQL required)
DATABASE_URL=postgresql://user:password@localhost:5432/facebook_ad_builder

# CORS (comma-separated list of allowed origins)
# Local dev supports either localhost or 127.0.0.1 as the browser origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.com,https://your-app.railway.app

# Production public origin. docker-compose.yml overrides this for local dev.
FRONTEND_URL=https://ads.nalar.army

# Auth
SECRET_KEY=your-secret-key-generate-with-python-secrets
# ACCESS_TOKEN_EXPIRE_MINUTES=30     # Optional, default 30 minutes
# REFRESH_TOKEN_EXPIRE_DAYS=7        # Optional, default 7 days

# OAuth token encryption (Google Ads, TikTok Ads connections) - required
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=your-fernet-key

# Trusted reverse-proxy hop (Caddy). Never set to "*" in production.
TRUSTED_PROXIES=127.0.0.1

# AI Services
GEMINI_API_KEY=your-gemini-api-key
FAL_AI_API_KEY=your-fal-ai-api-key
KIE_AI_API_KEY=your-kie-ai-api-key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Facebook Marketing API
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_AD_ACCOUNT_ID=your-ad-account-id
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_OAUTH_REDIRECT_URI=https://ads.nalar.army/api/v1/facebook/oauth/callback
FACEBOOK_APP_SECRET=your-facebook-app-secret
# FACEBOOK_ADS_LIBRARY_TOKEN=  # Optional, falls back to FACEBOOK_ACCESS_TOKEN

# Frontend env vars (VITE_ prefix required for Vite)
VITE_API_URL=http://localhost:8000/api/v1
VITE_FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
VITE_FACEBOOK_AD_ACCOUNT_ID=your-ad-account-id
VITE_FACEBOOK_API_VERSION=v24.0

# White-label branding (per-client build; defaults are Nalarin — see
# frontend/src/lib/branding.js). VITE_APP_LOGO is a path under frontend/public/.
#VITE_APP_NAME=Nalarin Ads Studio
#VITE_APP_LOGO=/nalarin_ads_studio_logo.png
#VITE_APP_TAGLINE=Paid media operations
#VITE_APP_OPERATOR=Banyumedia
#VITE_APP_OPERATOR_URL=https://banyumedia.co.id
# Brand accent color (hex) — recolors ALL UI accents at build time.
# Must be set BEFORE `vite build` (it is read in tailwind.config.js).
#VITE_APP_ACCENT=#B45309

# Backend brand name (used by future server-side references)
BRAND_NAME=Nalarin Ads Studio

# Supabase (optional, only if using Supabase)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Facebook Scraper (for ad library scraping with Playwright)
FB_SCRAPER_EMAIL=your-facebook-email
FB_SCRAPER_PASSWORD=your-facebook-password

# Google Ads (OAuth "Web application" client + a developer token from
# https://ads.google.com/aw/apicenter under your Google Ads manager account)
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
# Only needed if connecting via a manager (MCC) account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_OAUTH_REDIRECT_URI=https://ads.nalar.army/api/v1/google-ads/oauth/callback

# TikTok Marketing API (requires a TikTok for Business developer app approved
# for Marketing API access; leave blank until that manual onboarding is done)
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
TIKTOK_ADS_OAUTH_REDIRECT_URI=https://ads.nalar.army/api/v1/tiktok-ads/oauth/callback
# Override only when TikTok publishes/migrates a newer Marketing API version.
TIKTOK_ADS_API_BASE_URL=https://business-api.tiktok.com/open_api/v1.3

# Testing (for Playwright e2e tests)
TEST_EMAIL=test@example.com
TEST_PASSWORD=your-test-password
BASE_URL=http://localhost:5173
# TEST_DATABASE_URL=  # Optional, falls back to DATABASE_URL

# Admin user (optional - for init_db.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
